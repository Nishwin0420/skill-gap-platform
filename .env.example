# ==============================================================
# Skill‑Gap Platform — Environment Variables
# ==============================================================
# Copy this file to .env and fill in your actual values.
# NEVER commit the real .env file to git.
# ==============================================================

# ── Backend ───────────────────────────────────────────────────
# PostgreSQL connection string (Neon, Supabase, Railway Postgres, etc.)
DATABASE_URL=postgresql://user:password@host:5432/skillgap

# Groq LLM API key (https://console.groq.com)
GROQ_API_KEY=gsk_...

# Clerk authentication (https://dashboard.clerk.com)
CLERK_SECRET_KEY=sk_live_...

# Comma‑separated list of allowed CORS origins (your Vercel URL)
ALLOWED_ORIGINS=https://skill-gap-platform.vercel.app,https://skill-gap-platform-git-main.vercel.app

# Optional: Adzuna job API (market trends)
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Optional: GitHub API token (coding platform analyzer)
GITHUB_TOKEN=

# ── Frontend (React) ──────────────────────────────────────────
# URL where the FastAPI backend is running (Railway/Render URL in production)
REACT_APP_BACKEND_URL=https://skill-gap-backend.up.railway.app

# Clerk publishable key (safe to expose to browser)
REACT_APP_CLERK_PUBLISHABLE_KEY=pk_live_...
