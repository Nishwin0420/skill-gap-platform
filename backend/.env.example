# =========================================================
# Backend Environment Variables — copy to .env and fill in
# =========================================================

# --- Database ---
# Leave blank to use local SQLite (skillgap.db)
# In production on Render: set to your Neon.tech / Supabase PostgreSQL URL
# Format: postgresql://user:password@host:5432/dbname
DATABASE_URL=

# --- CORS ---
# Leave blank for localhost development
# In production: set to your Vercel deployment URL(s), comma-separated
# e.g: ALLOWED_ORIGINS=https://skill-gap.vercel.app
ALLOWED_ORIGINS=
